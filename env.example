# ─────────────────────────────────────────────────────────────
# .env.example  —  copy to .env for local dev, set as Railway
#                  environment variables in production
# ─────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────

# Telegram bot token from @BotFather
TELEGRAM_TOKEN=7123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your personal Telegram user ID or group chat ID
# Get it by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=123456789

# Helius API key — https://dashboard.helius.dev/
HELIUS_API_KEY=your-helius-api-key-here

# Full public URL of this app (used to register Helius webhook)
# e.g. https://whale-bot-production.up.railway.app
HELIUS_WEBHOOK_URL=https://YOUR-APP.up.railway.app/helius-webhook

# Moralis Web3 API key — https://admin.moralis.io/
MORALIS_API_KEY=your-moralis-api-key-here

# ── Optional ──────────────────────────────────────────────────

# HMAC secret for Helius webhook signature verification
# Set the same value in Helius dashboard → Webhook → Auth Header
HELIUS_WEBHOOK_SECRET=

# Minimum USD value to trigger an alert (default: 10000 = $10k)
MIN_USD_VALUE=10000

# Minimum days dormant before alerting (default: 45)
DORMANT_DAYS_MIN=45

# How often to poll EVM wallets via Moralis, in minutes (default: 5)
MORALIS_POLL_MINS=5

# Port Flask listens on (Railway sets this automatically)
PORT=8080
